# ---------- General ----------
ENV=dev                                   # dev | production. Unset means production: no /docs, no invite links in responses,
                                          # and the API refuses to start without SENTRAIL_JWT_PRIVATE_KEY
APP_URL=http://localhost:5173             # web app
API_URL=http://localhost:8000             # this API (used for the OIDC redirect URI)
AUTH_MODE=keycloak                        # keycloak (recommended) | local
# Hosted on qatech.world (AWS or GCP; see docs/DEPLOYMENT_DNS.md). Use these instead of the localhost values, with ENV=production:
# APP_URL=https://sentrail.qatech.world
# API_URL=https://api.sentrail.qatech.world
# KEYCLOAK_URL=https://auth.sentrail.qatech.world

# ---------- PostgreSQL ----------
POSTGRES_SUPERUSER_PASSWORD=
SENTRAIL_OWNER_PASSWORD=                  # owns the schema, used only by scripts/migrate.py
APP_DB_PASSWORD=                          # sentrail_app: what the API connects as (row-level security applies)
KEYCLOAK_DB_PASSWORD=
# Outside Docker:
DATABASE_URL=postgresql://sentrail_app:<APP_DB_PASSWORD>@127.0.0.1:5432/sentrail?sslmode=prefer
OWNER_DATABASE_URL=postgresql://sentrail_owner:<SENTRAIL_OWNER_PASSWORD>@127.0.0.1:5432/sentrail
# Production: sslmode=verify-full&sslrootcert=/run/secrets/pg-ca.crt

# ---------- Keycloak ----------
KEYCLOAK_URL=http://localhost:8080        # what browsers use
KEYCLOAK_REALM=sentrail
KEYCLOAK_CLIENT_ID=sentrail-web
KEYCLOAK_CLIENT_SECRET=                   # generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
KEYCLOAK_ADMIN_CLIENT_ID=sentrail-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=                      # Keycloak's own console admin (not a Sentrail user)
KEYCLOAK_ADMIN_PASSWORD=
TRUST_IDP_MFA=true                        # Keycloak requires two-factor for every user (see docs/IDENTITY.md)

# ---------- Observability (docker compose --profile observability up -d) ----------
GRAFANA_ADMIN_PASSWORD=                   # Grafana login for user "admin" (http://localhost:3000). Required: empty falls back to Grafana's default

# ---------- Seed ----------
SEED_ADMIN_EMAIL=                         # master (break-glass platform) login
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=                       # demo tenants only, never in production

# ---------- Encryption keys ----------
# Development: python -m scripts.generate_keys >> .env
SENTRAIL_DATA_KEYS=
SENTRAIL_INDEX_KEY=
SENTRAIL_JWT_PRIVATE_KEY=
# Production: leave those empty; keys are unwrapped through OpenBao transit
# BAO_ADDR=https://openbao.internal:8200
# BAO_TOKEN=
# BAO_TRANSIT_KEY=sentrail-data
# SENTRAIL_WRAPPED_KEYS=v1:vault:v1:...
# SENTRAIL_WRAPPED_INDEX_KEY=vault:v1:...

# ---------- Email ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@sentrail.qatech.world

# ---------- Detection and AI ----------
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# LLM provider: ollama (default; local) | openai_compatible (vLLM, llama.cpp server, LM Studio, or a hosted API).
AI_PROVIDER=ollama
# openai_compatible only: AI_BASE_URL ends in /v1 (for example http://localhost:8001/v1); AI_MODEL is required;
# AI_API_KEY only if the server wants one (server-side only, never in the frontend). AI_MODEL also overrides OLLAMA_MODEL.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# A provider outside this machine/network receives (masked) case text. Refused unless this is true, and then https is required.
AI_ALLOW_EXTERNAL=false
DATA_DIR=data
CHROMA_PATH=data/chroma
# Per-organization data lives in data/orgs/<org_id>/. The IBM demo dataset in data/ is served ONLY to this organization:
DEMO_DATA_ORG_ID=
# Sanctions screening fails closed: without a loaded OFAC list, transfers are held. false = offline demo using data/watchlist.csv only.
OFAC_REQUIRED=true
RISK_LIST_TTL_SECONDS=21600               # reload OFAC every 6 hours

# ---------- Single-VM HTTPS (docker-compose.prod.yml) ----------
ACME_EMAIL=                               # Let's Encrypt contact
