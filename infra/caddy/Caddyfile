# Reverse proxy for the single-VM deployment. Caddy gets and renews the Let's Encrypt certificates by itself.
# Needs DNS A records for the three names pointing at this VM, and ports 80 + 443 open.
{
	email {$ACME_EMAIL:admin@sentrail.qatech.world}
}

{$APP_HOST} {
	reverse_proxy web:8080
}

{$API_HOST} {
	reverse_proxy api:8000
}

{$AUTH_HOST} {
	reverse_proxy keycloak:8080
}

# Fallback: the same app on addresses that work before the domain's DNS has propagated (set by scripts/deploy.sh from the instance
# metadata). The web app sees it is not on the domain and calls the API on this origin under /api. The refresh cookie is scoped to
# /auth, so its path is moved to /api/auth. Password sign-in works here; SSO redirects (Keycloak) still use the domain names.
#   SSLIP_HOST     <ip-with-dashes>.sslip.io (resolves to this host): gets a trusted Let's Encrypt certificate.
#   FALLBACK_HOST  ec2-<ip>.compute-1.amazonaws.com: Let's Encrypt refuses amazonaws.com names, so a self-signed certificate
#                  (the browser warns once; choose "continue").
(fallback) {
	handle_path /api/* {
		reverse_proxy api:8000 {
			header_down Set-Cookie "(?i)path=/auth" "Path=/api/auth"
		}
	}
	handle {
		reverse_proxy web:8080
	}
}

{$SSLIP_HOST:sslip-unset.invalid} {
	import fallback
}

{$FALLBACK_HOST:localhost} {
	tls internal
	import fallback
}

# Plain-HTTP requests for any other name (the bare IP address, an unknown host) go to the trusted fallback name over HTTPS.
http:// {
	redir https://{$SSLIP_HOST:localhost}{uri} 302
}
