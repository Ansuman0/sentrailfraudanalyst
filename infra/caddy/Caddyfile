# Reverse proxy for the single-VM deployment. Caddy gets and renews the Let's Encrypt certificates by itself.
# Needs DNS A records for the three names pointing at this VM, and ports 80 + 443 open.
{
	email {$ACME_EMAIL:admin@sentrail.qatech.world}
}

{$APP_HOST} {
	reverse_proxy web:8080
}

{$API_HOST} {
	reverse_proxy api:8000
}

{$AUTH_HOST} {
	reverse_proxy keycloak:8080
}

# Fallback: the same app on the AWS public hostname (ec2-<ip>.compute-1.amazonaws.com, set by scripts/deploy.sh), so the site
# opens before the domain's DNS has propagated. The web app sees it is not on the domain and calls the API on this origin
# under /api. The refresh cookie is scoped to /auth, so its path is moved to /api/auth. Password sign-in works here; SSO
# redirects (Keycloak) still use the domain names.
{$FALLBACK_HOST:localhost} {
	handle_path /api/* {
		reverse_proxy api:8000 {
			header_down Set-Cookie "(?i)path=/auth" "Path=/api/auth"
		}
	}
	handle {
		reverse_proxy web:8080
	}
}

# Plain-HTTP requests for any other name (the bare IP address, an unknown host) go to the fallback hostname over HTTPS.
http:// {
	redir https://{$FALLBACK_HOST:localhost}{uri} 302
}
