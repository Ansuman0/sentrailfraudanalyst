{
  "realm": "sentrail",
  "displayName": "Sentrail",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(14) and maxLength(256) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "webAuthnPolicyRpEntityName": "Sentrail",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessRpEntityName": "Sentrail",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "actionTokenGeneratedByUserLifespan": 900,
  "actionTokenGeneratedByAdminLifespan": 259200,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "UPDATE_PASSWORD", "UPDATE_TOTP", "REMOVE_TOTP", "RESET_PASSWORD", "CODE_TO_TOKEN_ERROR"],
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "fr"],
  "defaultLocale": "en",
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=63072000; includeSubDomains",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "no-referrer"
  },
  "clients": [
    {
      "clientId": "sentrail-web",
      "name": "Sentrail web app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SENTRAIL_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${SENTRAIL_API_URL}/auth/oidc/callback"],
      "webOrigins": ["${SENTRAIL_APP_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SENTRAIL_APP_URL}/signed-out",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": ["openid", "profile", "email", "acr", "basic"]
    },
    {
      "clientId": "sentrail-admin",
      "name": "Sentrail user provisioning",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SENTRAIL_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-sentrail-admin",
      "enabled": true,
      "serviceAccountClientId": "sentrail-admin",
      "clientRoles": { "realm-management": ["manage-users", "view-users", "query-users"] }
    }
  ]
}
